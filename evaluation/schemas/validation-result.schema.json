{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cepraea.github.io/human-request-compiler/evaluation/schemas/validation-result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "criterionId",
    "status",
    "evidence"
  ],
  "properties": {
    "criterionId": {
      "type": "string"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "NOT_EVALUATED"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "evidence.schema.json"
      }
    }
  }
}
