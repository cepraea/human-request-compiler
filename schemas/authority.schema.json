{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cepraea.github.io/human-request-compiler/schemas/authority.schema.json",
  "title": "Authority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "executor",
    "approver",
    "authorizedActions",
    "reservedActions",
    "destructiveActionsRequireApproval"
  ],
  "properties": {
    "executor": {
      "type": "string",
      "minLength": 2
    },
    "approver": {
      "type": "string",
      "minLength": 2
    },
    "authorizedActions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 2
      },
      "uniqueItems": true
    },
    "reservedActions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2
      },
      "uniqueItems": true
    },
    "destructiveActionsRequireApproval": {
      "const": true
    }
  }
}
